# ── LLM Backend — choisir UN seul ─────────────────────────────

# Option 1 : Ollama (local, GRATUIT, recommandé pour la vie privée)
# Installer : https://ollama.com → puis : ollama pull llama3.1
LLM_BACKEND=ollama/llama3.1
# Autres modèles Ollama : ollama/qwen2.5:14b  ollama/mistral  ollama/llama3.2

# Option 2 : Groq (GRATUIT, 14 400 req/jour, très rapide)
# Clé gratuite : https://console.groq.com
# LLM_BACKEND=groq/llama-3.3-70b-versatile
# GROQ_API_KEY=gsk_...

# Option 3 : Google Gemini (GRATUIT, 1M tokens/jour)
# Clé gratuite : https://aistudio.google.com/app/apikey
# LLM_BACKEND=gemini/gemini-2.0-flash-exp
# GEMINI_API_KEY=AIza...

# Option 4 : Anthropic Claude (payant, meilleure qualité)
# LLM_BACKEND=anthropic/claude-sonnet-4-6
# ANTHROPIC_API_KEY=

# ── Outils OSINT optionnels ────────────────────────────────────

# HIBP : données de breach structurées ($3.50/mois)
# https://haveibeenpwned.com/API/Key
# HIBP_API_KEY=

# Pappers.fr : API business records (tier gratuit disponible)
# https://www.pappers.fr/api
# PAPPERS_API_KEY=

# Truecaller : caller ID crowdsourcé, excellent pour numéros français
# Connecter Truecaller une fois et extraire le token de session
# TRUECALLER_TOKEN=

# Telegram : lookup numéro → compte Telegram
# Créer une app sur https://my.telegram.org
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_PHONE=+33XXXXXXXXX
