# ── LLM Backend — choisir UN seul ─────────────────────────────

# Option 1 : Ollama (local, GRATUIT, recommandé pour la vie privée)
# Installer : https://ollama.com → puis : ollama pull llama3.1
LLM_BACKEND=ollama/llama3.1
# Autres modèles Ollama : ollama/qwen2.5:14b  ollama/mistral  ollama/llama3.2

# Watson peut utiliser un modèle DIFFÉRENT (plus léger/rapide) du pipeline.
# Idéal : modèle léger pour la conversation (qwen2.5:7b, llama3.2:3b, phi3:mini)
# et modèle lourd pour la synthèse finale (qwen2.5:32b, llama3.1:70b).
# Si non défini, Watson utilise LLM_BACKEND.
# WATSON_LLM_BACKEND=ollama/qwen2.5:7b

# Timeout LLM en secondes (défaut: 120 pour Watson, 300 pour la synthèse pipeline)
# LLM_TIMEOUT=300

# Option 2 : Groq (GRATUIT, 14 400 req/jour, très rapide)
# Clé gratuite : https://console.groq.com
# NB : Groq a déprécié les modèles Llama-3.x (juin 2026). Modèles actuels :
#   groq/openai/gpt-oss-120b (qualité), groq/openai/gpt-oss-20b (rapide), groq/qwen/qwen3.6-27b
# LLM_BACKEND=groq/openai/gpt-oss-120b
# GROQ_API_KEY=gsk_...

# Option 3 : Google Gemini (GRATUIT, 1M tokens/jour)
# Clé gratuite : https://aistudio.google.com/app/apikey
# LLM_BACKEND=gemini/gemini-2.0-flash-exp
# GEMINI_API_KEY=AIza...

# Option 4 : Anthropic Claude (payant, meilleure qualité)
# LLM_BACKEND=anthropic/claude-sonnet-4-6
# ANTHROPIC_API_KEY=sk-ant-...

# ── Email validation — Reacher (check-if-email-exists) ────────
# Docker requis : docker run -p 8080:8080 reacherhq/backend:latest
# Vérifie SMTP, MX, catch-all, disposable — fonctionne sur Gmail/Outlook etc.
# https://github.com/reacherhq/check-if-email-exists
# REACHER_URL=http://localhost:8080

# ── Outils OSINT optionnels ────────────────────────────────────

# HIBP : données de breach structurées ($3.50/mois)
# https://haveibeenpwned.com/API/Key
# HIBP_API_KEY=

# Pappers.fr : API business records (tier gratuit disponible)
# https://www.pappers.fr/api
# PAPPERS_API_KEY=

# Steam : timestamp exact de dernière connexion (lastlogoff) — clé gratuite.
# Sans clé, PAW se rabat sur la page communautaire publique (statut approximatif,
# ex. "Last Online 3 days ago"). https://steamcommunity.com/dev/apikey
# STEAM_API_KEY=

# Truecaller : caller ID crowdsourcé, excellent pour numéros français
# Connecter Truecaller une fois et extraire le token de session
# TRUECALLER_TOKEN=

# Telegram : lookup numéro → compte Telegram
# Créer une app sur https://my.telegram.org
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_PHONE=+33XXXXXXXXX
